<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>{% block title %}{{ w.legal }}{% endblock %}</title>
<style>
:root { --bg: #ffffff; --fg: #1c1f23; --muted: #5c6670; --line: #d9dee3; --link: #0b5cad;
  --banner-bg: #fff4d6; --banner-fg: #5a4300; --sample-bg: #8a1c1c; --sample-fg: #ffffff; color-scheme: light dark; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #15181b; --fg: #e6e9ec; --muted: #9aa4ad; --line: #2c3237; --link: #7ab4f5;
    --banner-bg: #3a3014; --banner-fg: #f3dc9b; --sample-bg: #b33a3a; --sample-fg: #ffffff; }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 46rem; margin: 0 auto; padding: 2rem 16px 4rem; }
a { color: var(--link); }
h1 { font-size: 1.6rem; line-height: 1.3; }
h2 { font-size: 1.2rem; margin-top: 2rem; }
.note, .meta { color: var(--muted); font-size: .9rem; }
.listing { list-style: none; padding: 0; }
.listing li { padding: .5rem 0; border-bottom: 1px solid var(--line); display: flex; gap: .75rem; align-items: baseline; flex-wrap: wrap; }
.listing .meta { margin-left: auto; }
.banner { background: var(--banner-bg); color: var(--banner-fg); padding: .6rem .9rem; border-radius: 6px; font-weight: 600; }
.banner.old { font-weight: 400; }
.sample { position: sticky; top: 0; z-index: 1; background: var(--sample-bg); color: var(--sample-fg); padding: .6rem 16px; text-align: center; font-weight: 700; letter-spacing: .02em; }
.doc-meta { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; color: var(--muted); font-size: .9rem; border-bottom: 1px solid var(--line); padding-bottom: .75rem; }
.doc-meta nav { margin-left: auto; display: flex; gap: .5rem; }
article table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
article th, article td { border: 1px solid var(--line); padding: .4rem .6rem; text-align: left; vertical-align: top; }
blockquote { margin: 1rem 0; padding-left: 1rem; border-left: 3px solid var(--line); color: var(--muted); }
.doc-foot { margin-top: 3rem; border-top: 1px solid var(--line); }
.doc-foot code { word-break: break-all; }
</style>
</head>
<body>
{% if mode != "final" %}<div class="sample" role="note" data-mode="sample">{{ w.sample }}{% if label.get('revision') %} · <span data-revision>{{ label.revision[:8] }}</span>{% endif %}</div>
{% endif %}
<main>
{% block body %}{% endblock %}
{% if label.get('release') %}<p class="meta" data-release>{{ w.release }} {{ label.release }}</p>
{% endif %}
</main>
</body>
</html>
