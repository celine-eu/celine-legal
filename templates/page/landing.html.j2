{% extends "page/base.html.j2" %}
{% from "page/_macros.html.j2" import listing, name %}
{% block body %}
<h1>{{ w.legal }}</h1>
{% if view.organisation %}
<section>
<h2>{{ w.documentsOf }} {{ name(view.organisation.organisation) }}</h2>
{{ listing(view.organisation.documents) }}
</section>
{% endif %}
<section>
<h2>{{ w.platform }}</h2>
<p class="note">{{ w.platformNote }}</p>
{% if view.platform %}{{ listing(view.platform) }}{% else %}<p>{{ w.nothingYet }}</p>{% endif %}
</section>
{% if view.catalogue %}
<p><a href="{{ "/catalogue" | u }}">{{ w.catalogue }}</a></p>
{% endif %}
{% endblock %}
