{#- Text helpers shared by the templates. Import with
    {% import 'macros/text.j2' as text %}. -#}

{#- A paragraph or list item that names an actor, wrapped at 88 columns so that the
    rendered text reflows whatever the names are. `lead` is the item's marker with its
    indentation ('- ', '  - ', '1. '); continuation lines are indented under the text.
    Ends with a newline. Use it as
    {% call text.wrap('- ') %}words {{ value }} words{% endcall %} -#}
{% macro wrap(lead='', width=88) %}
{{ lead }}{{ caller().split() | join(' ') | wordwrap(width - lead | length, false, '\n' ~ ' ' * (lead | length), false) }}
{% endmacro %}

{#- An English possessive: "Labs'" or "Land's". -#}
{% macro poss(name) %}{{ name }}{{ "'" if name.endswith('s') else "'s" }}{% endmacro %}

{#- A list of phrases joined as prose: "a", "a and b", "a, b and c" ("e" in Italian). -#}
{% macro join(items, lang) %}
{%- set conj = ' e ' if lang == 'it' else ' and ' -%}
{%- if items | length > 1 -%}
{{ items[:-1] | join(', ') }}{{ conj }}{{ items[-1] }}
{%- else -%}
{{ items | join('') }}
{%- endif -%}
{% endmacro %}

{#- An ISO 8601 date as the texts say it: "1 dicembre 2026", "1 December 2026". A blank
    stays a blank. -#}
{% set months = {
  'it': ['gennaio', 'febbraio', 'marzo', 'aprile', 'maggio', 'giugno', 'luglio', 'agosto',
         'settembre', 'ottobre', 'novembre', 'dicembre'],
  'en': ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August',
         'September', 'October', 'November', 'December'],
} %}
{% macro date(iso, lang) %}
{%- if iso | length == 10 and iso[4] == '-' -%}
{{ iso[8:] | int }} {{ months[lang][iso[5:7] | int - 1] }} {{ iso[:4] }}
{%- else -%}
{{ iso }}
{%- endif -%}
{% endmacro %}

{#- A tax code and VAT number: "C.F. e P. IVA X" when they are the same, each otherwise. -#}
{% macro tax_ids(party, lang) %}
{%- if lang == 'it' -%}
{{ 'C.F. e P. IVA ' ~ party.tax_code if party.tax_code == party.vat else 'C.F. ' ~ party.tax_code ~ ', P. IVA ' ~ party.vat }}
{%- else -%}
{{ 'tax code and VAT number ' ~ party.tax_code if party.tax_code == party.vat else 'tax code ' ~ party.tax_code ~ ', VAT number ' ~ party.vat }}
{%- endif -%}
{% endmacro %}

{#- The term a text defines for a party in quotes: its `term`, or else its short name. -#}
{% macro term(party) %}{{ party.term if party.term is defined else party.short }}{% endmacro %}

{#- A phrase with its first letter in capitals, the rest as it is. -#}
{% macro cap(phrase) %}{{ phrase[:1] | upper }}{{ phrase[1:] }}{% endmacro %}
